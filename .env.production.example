# ------------------------------------------------------------------
# Voxels — production configuration template.
#
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ONE. It is
# committed. Every value below is either a placeholder, a public setting,
# or a marker saying where a secret goes — which is the hosting
# platform's secret store, not a file in a git repository.
#
# On Render these are set in the Blueprint (`render.yaml`) or, for the
# secret ones, prompted for in the dashboard because they are declared
# `sync: false`. This file is the portable equivalent, so the same
# deployment can be reproduced on Fly, Railway, a VPS, or anywhere else
# that can run a Node process and hand it environment variables.
#
# The server refuses to start if any of these is malformed and reports
# every fault at once, by variable name only. It never prints a value,
# because a malformed secret is still a secret.
# ------------------------------------------------------------------

# ============================================================ runtime

# Turns off every local convenience at once:
#   - private/LAN browser origins stop being trusted automatically
#   - WALLY_PUBLIC_ORIGIN or WALLY_ALLOWED_ORIGINS becomes mandatory
#   - the boot banner stops listing this machine's network interfaces
NODE_ENV=production

# The platform assigns this. Render defaults to 10000; Fly and Heroku
# pick their own. Nothing in the code hardcodes a port.
PORT=10000

# The interface to bind. 0.0.0.0 is the only address a container's router
# can reach — leave it unless you know otherwise.
WALLY_BIND=0.0.0.0

# ============================================================ proxying

# How many reverse proxies sit in front of this process.
#
# Set it to the real number. This is not a toggle, it is a count, and it
# is what decides which entry in X-Forwarded-For is believed. The address
# is read from the RIGHT, so with 1 hop the client is the last entry —
# the one your proxy wrote. Set it too high and a client picks its own
# rate-limit bucket by sending its own X-Forwarded-For header; set it to
# 0 behind a proxy and every player in the world shares one bucket.
#
#   Render:              1
#   Fly.io:              1
#   Cloudflare + Render: 2
#   No proxy at all:     0
WALLY_TRUST_PROXY_HOPS=1

# The origin players actually type, including the scheme.
#
# MUST be https in production. A ws:// upgrade to a TLS-terminating host
# is answered with a 301 redirect, and most WebSocket clients fail rather
# than follow it — the game would load and never connect.
WALLY_PUBLIC_ORIGIN=https://voxels.example.com

# Every browser origin allowed to call the API and open a socket,
# comma-separated. WALLY_PUBLIC_ORIGIN is added automatically.
#
# Needed when the client is served from a different host than the API,
# which is the normal arrangement: a CDN-hosted static site plus a
# separate API service. In production nothing else is accepted — there is
# no automatic allowance for loopback or private addresses, because on a
# public host "it came from 10.0.0.5" says nothing about who sent it.
WALLY_ALLOWED_ORIGINS=https://voxels.example.com

# Hostnames accepted in the `domain` field of a Sign-In With Solana
# message. Derived from the origins above when empty, which keeps the
# signed domain binding and the CORS policy from drifting apart.
WALLY_SIWS_DOMAINS=

# ============================================================ database

# sqlite | postgres. Defaults to postgres when DATABASE_URL is set.
#
# SQLite is correct on a laptop and is data loss in production: a
# container filesystem is wiped on every redeploy, restart and scale
# event. The server logs a loud warning if it finds itself in production
# on SQLite; do not ignore it.
WALLY_DB_DRIVER=postgres

# ################################################################
# # SECRET — set this in the platform's secret store, not here.  #
# ################################################################
# The password is inside the URL. It is registered in
# src/server/redact.ts, so it is scrubbed out of logs and error messages
# and never appears in an API response; /api/health reports a SHA-256
# fingerprint of it instead.
#
#   postgres://USER:PASSWORD@HOST:5432/DATABASE
#
# On Render this comes from the managed database automatically, via
# `fromDatabase: { name: voxels-db, property: connectionString }`.
DATABASE_URL=

# Managed Postgres requires TLS. A local Postgres container usually does
# not. Defaults to on in production.
WALLY_DB_SSL=true

# Connections held by this process. Render's smaller Postgres plans cap
# at 100 connections across everything that connects, so the web service
# and the worker have to share that budget.
WALLY_DB_POOL_MAX=8

# Schema holding the financial tables when running on Postgres, which is
# the Postgres equivalent of the separate SQLite file used locally.
WALLY_DB_FINANCE_SCHEMA=finance

# SQLite paths. Ignored entirely when the driver is postgres.
WALLY_DB_PATH=
WALLY_FINANCE_DB_PATH=

# ============================================================ the world

# Players this one process will hold, and a promise rather than a hope:
# it is enforced at the socket upgrade and published on /api/health.
#
# THERE IS EXACTLY ONE WORLD PROCESS. Do not run a second instance of the
# API service. The world lives in this process's memory and there is no
# room ownership or routing anywhere in this codebase, so a second
# instance is a second town behind the same URL — two players would open
# the game and not see each other. More capacity means a bigger machine,
# not more machines.
WALLY_ROOM_CAPACITY=64

# Milliseconds to spend draining on SIGTERM: telling connected players the
# world is restarting, voiding open duels and returning both stakes,
# recording positions, then closing the database.
#
# Must be comfortably under the platform's own kill deadline. Render
# allows 30s by default and up to 300s via `maxShutdownDelaySeconds`.
WALLY_SHUTDOWN_GRACE_MS=25000

WALLY_NONCE_TTL_MS=300000
WALLY_SESSION_TTL_MS=604800000

# ============================================================== solana

# devnet | testnet | mainnet-beta.
# mainnet-beta means every signature moves real money.
SOLANA_CLUSTER=devnet

# ################################################################
# # SECRET — set these in the platform's secret store, not here. #
# ################################################################
# A provider endpoint IS the credential: QuickNode, Helius and the rest
# put the access token in the URL path, so whoever holds the URL can
# spend the quota.
#
# It belongs in a server-side variable and nowhere else. It is never
# logged, never returned by an endpoint, and never sent to the browser —
# the client reaches the chain through this server's /api/rpc proxy.
# /api/health reports only the NAME of the variable it was read from.
#
# Scoped per cluster so a devnet run cannot quietly spend the mainnet
# quota. mainnet-beta refuses to start without one, because the public
# mainnet endpoint is rate-limited into uselessness for an application.
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_MAINNET_BETA=
SOLANA_RPC_URL_TESTNET=
SOLANA_RPC_URL=

# ============================================================ payments

# NPC service payments are OFF on every deployment and this variable does
# not switch them on: a fee is a SOL transfer the player signs, and there is
# no transaction signer in the client. /api/health reports
# paymentsEnabled: false whatever is set here.
#
# PUBLIC KEY of the address that would receive NPC service fees. The matching
# secret key must never be placed in this project — nothing here can sign
# anything, and that is a property worth keeping.
NPC_PAYEE_ADDRESS=

# Whole lamports, integer. Default 1000000 (0.001 SOL).
NPC_SERVICE_PRICE_LAMPORTS=

# ============================================================== client
#
# ###############################################################
# #  EVERYTHING BELOW IS PUBLIC.                                #
# #                                                             #
# #  Vite compiles every VITE_* value into the JavaScript        #
# #  bundle. Anyone who loads the page can read it. A provider   #
# #  URL, a database URL, an API key or any other credential     #
# #  placed here is published, not configured.                   #
# #                                                             #
# #  `npm run audit:bundle` searches the built output for the    #
# #  real values of the server-side secrets and fails if it      #
# #  finds one. Run it after every build.                        #
# ###############################################################

# Where the browser reaches the API. Needed when the client is served
# from a different host than the API. Leave it empty and the client uses
# the page's own origin, which is correct when one host serves both.
#
# Must be https on a public deployment: the WebSocket URL is derived from
# it, and https becomes wss automatically.
VITE_API_BASE_URL=https://voxels-api.example.com

# Must match SOLANA_CLUSTER, or balances will be labelled with a network
# they did not come from. The server checks the genesis hash and reports
# a mismatch on /api/health.
VITE_SOLANA_CLUSTER=devnet

# Leave EMPTY. It exists only for a local validator on devnet, and the
# client refuses it outright on mainnet, because there is no way to put a
# mainnet provider URL in a public bundle safely.
VITE_SOLANA_RPC_URL=
