# ------------------------------------------------------------------
# Wally World configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must only
# ever contain empty placeholders. No secret belongs in any VITE_* value:
# everything prefixed VITE_ is compiled into the JavaScript bundle and is
# public to anyone who loads the page.
#
# There is no private key or seed phrase in this configuration, and none
# is needed. Phantom holds the user's key and performs every signature;
# the server only verifies signatures and reads the chain.
# ------------------------------------------------------------------

# ---------------------------------------------------------------- client

# devnet (default) | testnet | mainnet-beta
# Leave empty for devnet. mainnet-beta is an explicit opt-in and means every
# signature moves real money.
VITE_SOLANA_CLUSTER=

# RPC endpoint. Optional for devnet/testnet, which fall back to the public
# Solana endpoints. REQUIRED for mainnet-beta: the public mainnet endpoint is
# rate-limited and unusable for an application, so the app refuses to start on
# mainnet without a provider endpoint here (Helius, QuickNode, Triton, or your
# own validator). Supply the full URL including any key your provider embeds in
# it, and remember this value ships to the browser.
VITE_SOLANA_RPC_URL=

# Base URL of the API in src/server/index.ts. Defaults to http://127.0.0.1:8787
VITE_API_BASE_URL=

# ---------------------------------------------------------------- server

PORT=

# Must match VITE_SOLANA_CLUSTER. The server checks the RPC genesis hash and
# reports a mismatch on /api/health.
SOLANA_CLUSTER=

# Server-side RPC endpoint, used to confirm payments against the chain. Same
# rule as the client: required when SOLANA_CLUSTER=mainnet-beta. This one is
# NOT exposed to the browser, so a keyed provider URL is safer here.
SOLANA_RPC_URL=

# SQLite file. Defaults to data/wally.db (gitignored).
WALLY_DB_PATH=

# Comma-separated browser origins allowed to call the API.
# Defaults to http://127.0.0.1:5173,http://localhost:5173
WALLY_ALLOWED_ORIGINS=

# Comma-separated hostnames accepted in the `domain` field of a sign-in
# message. Derived from WALLY_ALLOWED_ORIGINS when empty.
WALLY_SIWS_DOMAINS=

# Sign-in challenge lifetime in ms. Default 300000 (5 minutes).
WALLY_NONCE_TTL_MS=

# Session lifetime in ms. Default 604800000 (7 days).
WALLY_SESSION_TTL_MS=

# ---------------------------------------------------------- NPC payments

# Public address that receives NPC service fees. This is a PUBLIC KEY only —
# the corresponding secret key must never be placed in this project.
# Payments stay switched off while this is empty, because sending money to an
# address this repository made up would be sending it nowhere recoverable.
NPC_PAYEE_ADDRESS=

# Service price in whole lamports (integer). Default 1000000 (0.001 SOL).
NPC_SERVICE_PRICE_LAMPORTS=

# ------------------------------------------------------- not implemented

# Gold-to-token payout is not implemented and is not enabled by any
# configuration value. It is hardcoded off in src/server/config.ts. See the
# "Gold payouts" section of the README for what would have to be built first.
# There is no WALLY token mint; do not put an address here expecting one.
