# ------------------------------------------------------------------
# Voxels configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must only
# ever contain empty placeholders. No secret belongs in any VITE_* value:
# everything prefixed VITE_ is compiled into the JavaScript bundle and is
# public to anyone who loads the page.
#
# There is no private key or seed phrase in this configuration, and none
# is needed. Each player's key is generated in their own browser and never
# leaves it; the server only verifies signatures and reads the chain.
# ------------------------------------------------------------------

# ---------------------------------------------------------------- client

# devnet (default) | testnet | mainnet-beta
# Leave empty for devnet. mainnet-beta is an explicit opt-in and means every
# signature moves real money.
VITE_SOLANA_CLUSTER=

# Optional escape hatch for local and devnet work ONLY.
#
# READ THIS BEFORE SETTING IT. Whatever you put here is compiled into the
# JavaScript bundle and is readable by anyone who loads the page. A provider
# endpoint is a credential — QuickNode, Helius and the rest embed the access
# token in the URL — so putting a keyed URL here publishes it, and anyone who
# finds it can spend your quota.
#
# Leave it empty and the client sends its RPC traffic to the backend proxy at
# <VITE_API_BASE_URL>/api/rpc, which holds the endpoint server-side. That is the
# only supported arrangement for mainnet, and the client refuses to use this
# variable when the cluster is mainnet-beta.
#
# Reasonable values: empty, a public endpoint, or http://127.0.0.1:8899 for a
# local test validator.
VITE_SOLANA_RPC_URL=

# Optional. Leave empty for local play.
#
# In the browser the client uses the same host the page was loaded from
# (Vite proxies /api and /ws to the API). A baked http://127.0.0.1:8787 is
# ignored when the page itself is not on loopback, so a friend opening
# http://192.168.x.x:5173 talks to this world's server, not their laptop.
# Set this only for a real deploy where the API lives on another public host.
# Never put a QuickNode or other provider URL here.
VITE_API_BASE_URL=

# ---------------------------------------------------------------- server

PORT=

# Must match VITE_SOLANA_CLUSTER. The server checks the RPC genesis hash and
# reports a mismatch on /api/health.
SOLANA_CLUSTER=

# Server-side RPC endpoint. This is where a keyed provider URL belongs: it is
# never sent to the browser, never logged, and never included in an API
# response. The server uses it to confirm payments against the chain and to
# serve the /api/rpc proxy on the client's behalf.
#
# Prefer the cluster-scoped form below. It is checked first, and it means a
# mainnet credential cannot be spent by a devnet run that you thought was safe:
#
#   SOLANA_RPC_URL_MAINNET_BETA=     used only when SOLANA_CLUSTER=mainnet-beta
#   SOLANA_RPC_URL_DEVNET=           used only when SOLANA_CLUSTER=devnet
#   SOLANA_RPC_URL_TESTNET=          used only when SOLANA_CLUSTER=testnet
#
# SOLANA_RPC_URL is the fallback for whichever cluster is selected. Required
# when SOLANA_CLUSTER=mainnet-beta — the public mainnet endpoint is rate-limited
# and unusable for an application, so the server refuses to start without one.
# devnet and testnet fall back to the public Solana endpoints.
SOLANA_RPC_URL=
SOLANA_RPC_URL_MAINNET_BETA=
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_TESTNET=

# SQLite file. Defaults to data/wally.db (gitignored).
WALLY_DB_PATH=

# Extra browser origins allowed to call the API, in addition to loopback
# and private LAN addresses (those are always accepted). Defaults to
# http://127.0.0.1:5173,http://localhost:5173
WALLY_ALLOWED_ORIGINS=

# Interface the API binds. Default 0.0.0.0 so LAN clients can reach this world.
WALLY_BIND=

# UI port printed at API start so you can send the LAN URL. Default 5173.
WALLY_UI_PORT=

# Comma-separated hostnames accepted in the `domain` field of a sign-in
# message. Derived from WALLY_ALLOWED_ORIGINS when empty.
WALLY_SIWS_DOMAINS=

# Sign-in challenge lifetime in ms. Default 300000 (5 minutes).
WALLY_NONCE_TTL_MS=

# Session lifetime in ms. Default 604800000 (7 days).
WALLY_SESSION_TTL_MS=

# ---------------------------------------------------------- NPC payments
#
# NPC service payments are OFF on every deployment and this variable does
# not switch them on. Paying a fee means signing a SOL transfer, and there
# is no transaction signer in the client: each player's browser-held key
# signs identity challenges only. /api/health reports
# paymentsEnabled: false regardless of what is set here.

# Public address that would receive NPC service fees. This is a PUBLIC KEY
# only — the corresponding secret key must never be placed in this project.
# Still read, and still reported by the operator console, but it enables
# nothing on its own.
NPC_PAYEE_ADDRESS=

# Service price in whole lamports (integer). Default 1000000 (0.001 SOL).
NPC_SERVICE_PRICE_LAMPORTS=

# ------------------------------------------------------- not implemented

# Gold-to-token payout is not implemented and is not enabled by any
# configuration value. It is hardcoded off in src/server/config.ts. See the
# "Gold payouts" section of the README for what would have to be built first.
# There is no WALLY token mint; do not put an address here expecting one.
